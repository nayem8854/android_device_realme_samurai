# b/148033913
dontaudit fsck self:capability kill;

# b/151195350
dontaudit linkerconfig self:capability kill;

# b/152468658
dontaudit vdc self:capability kill;

# kworker threads signal kernel processes internally (e.g. memory reclaim, OOM).
dontaudit kernel self:capability kill;

# MediaProvider queries isub (radio_service)
dontaudit mediaprovider_app radio_service:service_manager find;
